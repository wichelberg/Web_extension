{
  "manifest_version": 3,
  "name": "Zyraena Web Control",
  "version": "1.1",
  "description": "Lets Zyraena use Opera GX for you: tabs, reading pages, clicking, typing, downloads and uploads. She asks you before every step.",
  "key": "",
  "permissions": ["tabs", "scripting", "downloads", "alarms"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Zyraena Web Control: not connected" }
}
